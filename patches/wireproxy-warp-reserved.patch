+func TestWireguardConfWithReserved(t *testing.T) {
+	const config = `
+[Interface]
+PrivateKey = LAr1aNSNF9d0MjwUgAVC4020T0N/E5NUtqVv5EnsSz0=
+Address = 172.16.0.2/32
+Reserved = OH+u
+`
+	var cfg DeviceConfig
+	iniData, err := loadIniConfig(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = ParseInterface(iniData, &cfg); err != nil {
+		t.Fatal(err)
+	}
+	if want := [3]byte{56, 127, 174}; !reflect.DeepEqual(cfg.Reserved, want) {
+		t.Fatalf("Reserved = %v, want %v", cfg.Reserved, want)
+	}
+}
diff --git a/reserved_bind_test.go b/reserved_bind_test.go
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/reserved_bind_test.go
@@ -0,0 +1,57 @@
+package wireproxy
+
+import (
+	"testing"
+
+	"golang.zx2c4.com/wireguard/conn"
+)
+
+type testBind struct {
+	sent []byte
+}
+
+func (b *testBind) Open(port uint16) ([]conn.ReceiveFunc, uint16, error) {
+	receive := func(bufs [][]byte, sizes []int, eps []conn.Endpoint) (int, error) {
+		copy(bufs[0], []byte{2, 9, 8, 7})
+		sizes[0] = 4
+		return 1, nil
+	}
+	return []conn.ReceiveFunc{receive}, port, nil
+}
+
+func (b *testBind) Close() error                                { return nil }
+func (b *testBind) SetMark(uint32) error                        { return nil }
+func (b *testBind) ParseEndpoint(string) (conn.Endpoint, error) { return nil, nil }
+func (b *testBind) BatchSize() int                              { return 1 }
+
+func (b *testBind) Send(bufs [][]byte, _ conn.Endpoint) error {
+	b.sent = append([]byte(nil), bufs[0]...)
+	return nil
+}
+
+func TestReservedBind(t *testing.T) {
+	base := &testBind{}
+	bind := &reservedBind{Bind: base, reserved: [3]byte{56, 127, 174}}
+
+	outbound := [][]byte{{1, 0, 0, 0, 5}}
+	if err := bind.Send(outbound, nil); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := base.sent[:4], []byte{1, 56, 127, 174}; string(got) != string(want) {
+		t.Fatalf("outbound header = %v, want %v", got, want)
+	}
+
+	receive, _, err := bind.Open(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inbound := [][]byte{make([]byte, 4)}
+	sizes := make([]int, 1)
+	endpoints := make([]conn.Endpoint, 1)
+	if _, err = receive[0](inbound, sizes, endpoints); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := inbound[0], []byte{2, 0, 0, 0}; string(got) != string(want) {
+		t.Fatalf("inbound header = %v, want %v", got, want)
+	}
+}
