--- a/wireguard.go
+++ b/wireguard.go
@@ -21,6 +21,40 @@ type DeviceSetting struct {
 	MTU        int
 }
 
+type reservedBind struct {
+	conn.Bind
+	reserved [3]byte
+}
+
+func (b *reservedBind) Open(port uint16) ([]conn.ReceiveFunc, uint16, error) {
+	receive, actualPort, err := b.Bind.Open(port)
+	if err != nil {
+		return nil, 0, err
+	}
+	for i, receiveFunc := range receive {
+		fn := receiveFunc
+		receive[i] = func(bufs [][]byte, sizes []int, eps []conn.Endpoint) (int, error) {
+			n, err := fn(bufs, sizes, eps)
+			for j := 0; j < n; j++ {
+				if sizes[j] >= 4 {
+					clear(bufs[j][1:4])
+				}
+			}
+			return n, err
+		}
+	}
+	return receive, actualPort, nil
+}
+
+func (b *reservedBind) Send(bufs [][]byte, endpoint conn.Endpoint) error {
+	for _, buf := range bufs {
+		if len(buf) >= 4 {
+			copy(buf[1:4], b.reserved[:])
+		}
+	}
+	return b.Bind.Send(bufs, endpoint)
+}
